# RAGv3 环境变量配置
# 复制本文件为 .env 并填入你的 API Key
#
# cp .env.example .env

# DeepSeek 生成模型
RAG_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_MODEL=deepseek-v4-flash

# 硅基流动 嵌入模型（bge-m3，免费额度）
RAG_BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
# RAG_BAILIAN_BASE_URL=https://api.siliconflow.cn/v1
# RAG_BAILIAN_EMBED_MODEL=BAAI/bge-m3

# 百炼 Rerank（如果 reranker 也欠费，可注释掉，系统会跳过重排序）
# RAG_BAILIAN_API_KEY=sk-xxxxxxxxxxxxxxxx
# RAG_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_BAILIAN_RERANK_MODEL=gte-rerank-v2

# 鉴权（默认开启）
# 上线前请务必设置为 true；若绑定非回环地址（如 0.0.0.0）且认证关闭，
# start.py 会打印 ERROR 告警，但仍会继续启动。
RAG_AUTH_ENABLED=true
# 格式：{"user_id": "api_key"}
# RAG_AUTH_KEYS={"user1": "your-api-key"}

# Redis（Docker Compose 必填；请使用 URL-safe 随机字符串）
REDIS_PASSWORD=

# 外部数据源（默认关闭；开启后仅管理员可以管理）
# RAG_DATA_SOURCES_ENABLED=false

# 权威数据自动备份（默认开启；每 7 天一次，保留最近 8 份）
# 本地默认目录是项目同级的 RAGv3-backups；Docker Compose 会覆盖为 /app/backups。
# RAG_BACKUP_ENABLED=true
# RAG_BACKUP_ROOT=../RAGv3-backups
# RAG_BACKUP_INTERVAL_DAYS=7
# RAG_BACKUP_RETENTION_COUNT=8
# RAG_BACKUP_CHECK_INTERVAL_SECONDS=3600

# 文档版本存储（可信知识闭环，可选）
# RAG_DOCUMENT_VERSIONS_ROOT=./data/document_versions
# RAG_FEEDBACK_CLUSTER_DAYS=30
# RAG_FEEDBACK_CLUSTER_USERS=3
# RAG_KNOWLEDGE_TASK_DUE_DAYS=7
# RAG_KNOWLEDGE_STALE_DAYS=180
# RAG_HISTORICAL_RESULT_WEIGHT=0.35

# 增量资料生命周期（可选）
# RAG_MATERIAL_FILE_MAX_BYTES=52428800
# RAG_MATERIAL_ARCHIVE_MAX_BYTES=209715200
# RAG_MATERIAL_DEBOUNCE_SECONDS=300
# RAG_MATERIAL_WORKER_LEASE_SECONDS=120
# RAG_MATERIAL_JOB_MAX_ATTEMPTS=5
# RAG_MATERIAL_JOB_QUEUE_LIMIT=10000
# RAG_LEGACY_OFFICE_ENABLED=false
# RAG_LEGACY_OFFICE_LAUNCHER=
# RAG_LEGACY_OFFICE_TIMEOUT_SECONDS=60
# RAG_LEGACY_OFFICE_MAX_MEMORY_MB=512

# 日志级别（DEBUG / INFO / WARNING / ERROR）
# RAG_LOG_LEVEL=INFO

# 生产环境 JSON 格式日志
# RAG_LOG_JSON=0

# 首次部署时指定初始管理员用户名（可选）
# INIT_ADMIN_USERNAME=admin
