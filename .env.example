# RAGv3 环境变量配置
# 复制本文件为 .env 并填入 API Key。禁止提交真实 .env。
#
# Copy-Item .env.example .env

# DeepSeek：回答生成、旧路由及必要时的查询改写
RAG_DEEPSEEK_API_KEY=
RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_DEEPSEEK_MODEL=deepseek-v4-flash
# 生成/改写温度：0.0 = 同问同答优先（可复现）；单次调用显式传温度时以调用方为准。
RAG_GENERATION_TEMPERATURE=0.0
# 自定义认证头：部分 OpenAI 兼容提供商不用 Authorization: Bearer，
# 而用例如 x-api-key 的头携带同一个密钥；为空时保持标准 Bearer 行为。
RAG_DEEPSEEK_AUTH_HEADER=

# 硅基流动：嵌入模型和旧 reranker 降级
RAG_BAILIAN_API_KEY=
RAG_BAILIAN_BASE_URL=https://api.siliconflow.cn/v1
RAG_BAILIAN_EMBED_MODEL=BAAI/bge-m3
RAG_EMBED_DIMENSION=1024

# TypeSafe / Jev
# 聊天中暴露过的密钥应先轮换，再写到本机 .env。
RAG_TYPESAFE_API_KEY=
RAG_JEV_MODE=off
RAG_JEV_MODEL=jev-latest
# 超时按实测校准：稳态 0.3-0.9s，冷启动约 1.35s；1.5s 会触发 SDK 重试放大 P95。
RAG_JEV_TIMEOUT_SECONDS=3.0
RAG_JEV_ROUTE_CONFIDENCE=0.75
# 预判改写概率达到该阈值才改写；提高可降低改写率与尾延迟。
RAG_JEV_REWRITE_PROBABILITY=0.55
# 逗号分隔的知识库 ID，例如：kb_1,kb_2
RAG_JEV_KB_ALLOWLIST=

# 鉴权（默认开启）
RAG_AUTH_ENABLED=true
RAG_SELF_REGISTRATION_ENABLED=false
RAG_ALLOW_INITIAL_PASSWORDS_REMOTE=false
# 格式：{"user_id": "api_key"}
# RAG_AUTH_KEYS={"user1": "your-api-key"}

# Redis
RAG_REDIS_URL=redis://localhost:6379/0
# 单机开发 Redis 可选：挂掉时 /ready 报 degraded 但仍 200。
# 多副本/共享缓存/锁部署必须设 true，让 Redis 故障阻塞 /ready。
RAG_REDIS_REQUIRED=false
# Docker Compose 可使用 URL-safe 随机密码
REDIS_PASSWORD=

# Qdrant（Phase 1）
# 默认空 = 本地嵌入式目录（RAG_QDRANT_PATH），单进程、目录独占锁，保持旧行为。
# 多进程/多副本必须切 server 模式：Compose 内填 http://qdrant:6333。
# 回滚：清空 RAG_QDRANT_URL 并重启；旧的 qdrant_data 卷保留为只读副本。
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
# RAG_QDRANT_PATH=./qdrant_data
# Compose 的 qdrant 服务与 rag-app 共用该密钥；留空 = 不启用认证（仅内网可达）。
# 启用认证：填 URL-safe 随机值，并取消 docker-compose.yml 里
# QDRANT__SERVICE__API_KEY 那一行的注释（不要把该变量设成空字符串，见 qdrant#8856）。
QDRANT_API_KEY=

# 外部数据源（默认关闭；开启后仅管理员可以管理）
# RAG_DATA_SOURCES_ENABLED=false

# 权威数据自动备份（默认开启；每 7 天一次，保留最近 8 份）
# 本地默认目录是项目同级的 RAGv3-backups；Docker Compose 会覆盖为 /app/backups。
# RAG_BACKUP_ENABLED=true
# RAG_BACKUP_ROOT=../RAGv3-backups
# RAG_BACKUP_INTERVAL_DAYS=7
# RAG_BACKUP_RETENTION_COUNT=8
# RAG_BACKUP_CHECK_INTERVAL_SECONDS=3600

# 文档版本存储（可信知识闭环，可选）
# RAG_DOCUMENT_VERSIONS_ROOT=./data/document_versions
# RAG_FEEDBACK_CLUSTER_DAYS=30
# RAG_FEEDBACK_CLUSTER_USERS=3
# RAG_KNOWLEDGE_TASK_DUE_DAYS=7
# RAG_KNOWLEDGE_STALE_DAYS=180
# RAG_HISTORICAL_RESULT_WEIGHT=0.35

# 增量资料生命周期（可选）
# RAG_MATERIAL_WORKER_LEASE_SECONDS=120
# RAG_MATERIAL_JOB_MAX_ATTEMPTS=5

# 检索前改写缓存（进程内 LRU；重启即失效）
# RAG_QUERY_REWRITE_CACHE_ENABLED=true
# RAG_QUERY_REWRITE_CACHE_SIZE=512

# 双路重排：below_threshold=仅当改写句最高分低于阈值时再用原问题补一次（默认）
# always=每条改写请求都补；off=关闭，回到 2026-10-21 之前的行为
# RAG_REWRITE_DUAL_RERANK_MODE=below_threshold
# RAG_REWRITE_DUAL_RERANK_THRESHOLD=0.5

# 日志级别（DEBUG / INFO / WARNING / ERROR）
# RAG_LOG_LEVEL=INFO

# 生产环境 JSON 格式日志
# RAG_LOG_JSON=0

# 首次部署时指定初始管理员用户名（可选）
# INIT_ADMIN_USERNAME=admin
